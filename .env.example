# Copy this file to .env and fill in your own values. Never commit .env.

# Which LLM provider to use: "openai" (default, per the original spec) or
# "groq" (free tier, good for development/demo without OpenAI billing).
LLM_PROVIDER=openai

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-...

# --- Groq (used when LLM_PROVIDER=groq) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional: override the default model for whichever provider is active.
# Defaults: gpt-4.1 for openai, llama-3.3-70b-versatile for groq.
LLM_MODEL=

# Optional: sampling temperature used as the default across agents (each
# agent also has its own hardcoded temperature tuned for its task)
LLM_TEMPERATURE=0.4

# --- Grounding (RAG) for the Planner Agent ---
# Set to "false" to disable grounding entirely and rely purely on the LLM's
# own knowledge. Default is "true".
ENABLE_GROUNDING=true

# Optional: enables LIVE web-search grounding (via Tavily) instead of the
# built-in local question bank. Leave blank to use the local bank only --
# it works out of the box with no key. Free tier (1000 searches/month) at
# https://tavily.com
TAVILY_API_KEY=
