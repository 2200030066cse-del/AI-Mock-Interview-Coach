# Template for Streamlit Community Cloud's secrets manager.
#
# This file is NOT read by the app directly and is safe to commit -- it's a
# template only. When deploying on share.streamlit.io, paste the contents
# below (with real values) into your app's Settings -> Secrets box. For
# local development, use `.env` instead (see `.env.example`).

LLM_PROVIDER = "groq"

OPENAI_API_KEY = ""
GROQ_API_KEY = "gsk_your_key_here"

LLM_MODEL = ""
LLM_TEMPERATURE = "0.4"

ENABLE_GROUNDING = "true"
TAVILY_API_KEY = ""
